        <mxCell id="2" value="跨平台 Synergy 的反事实估计与 Toy Example" style="text;html=1;align=center;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="3" value="1. 观测数据&#xa;小时级注意力、跳转、转载&#xa;外部冲击与初始投放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="4" value="2. 估计传播矩阵&#xa;K = K₀ + K×&#xa;内部传播 + 跨平台传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="5" value="3A. 完整网络&#xa;T_coupled = sᵀ(I-K)⁻¹1&#xa;保留跨平台导流、接力与反馈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="6" value="3B. 关闭跨平台边&#xa;T_isolated = sᵀ(I-K₀)⁻¹1&#xa;保持相同初始流入与内部机制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#e67e22;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="360" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="7" value="4. Synergy&#xa;T_coupled / T_isolated&#xa;识别跨平台结构性增益" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="235" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="8" value="事件 A：跨平台接力&#xa;初始流入 100 → 累计 231.88&#xa;反事实 125.00&#xa;Synergy = 1.855；结构增益 = 85.5%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="580" width="570" height="190" as="geometry"/></mxCell>
